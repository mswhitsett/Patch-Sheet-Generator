{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patch 2",
  "version": "2.0.0",
  "identifier": "church.waymaker.patchsheet.v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Patch v2.0",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
